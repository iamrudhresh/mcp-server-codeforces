# Codeforces MCP Server - configuration (all optional)
# No credentials are needed: the server only performs public, read-only calls.

# HTTP transport bind address (python run_server.py --http)
HOST=0.0.0.0
PORT=8000

# Codeforces API
CODEFORCES_API_URL=https://codeforces.com/api
CODEFORCES_LANG=en

# Networking
REQUEST_TIMEOUT=30.0
MAX_RETRIES=3
# Codeforces allows roughly one call every two seconds; keep this >= 1.0
MIN_REQUEST_INTERVAL=1.1

# Caching (seconds)
CACHE_TTL=600
PROBLEMSET_TTL=1800
MAX_CACHE_ENTRIES=64
